# API under test (default: example.com; no real API needed)
AI_API_BASE_URL="https://example.com"
MOCK_MODE="true"

# OpenAI
OPENAI_API_KEY="sk-XXXX"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Similarity expectations (demo-friendly defaults)
MIN_INTENT_SIMILARITY="0.75"
MIN_REPLY_SIMILARITY="0.78"

# Embeddings provider
EMBEDDINGS_PROVIDER=sklearn
# EMBEDDINGS_PROVIDER=openai
